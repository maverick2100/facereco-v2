# ---------------------------------------------------------------- models / ANE
FR_SCRFD_MODEL=models/scrfd.mlpackage
FR_ARCFACE_MODEL=models/arcface.mlpackage
# CPU_AND_NE = Neural Engine + CPU fallback, never GPU (recommended)
# ALL | CPU_AND_NE | CPU_ONLY | CPU_AND_GPU
FR_COMPUTE_UNITS=CPU_AND_NE
FR_CACHE_COMPILED=true
FR_WARMUP_ITERS=3
# Only used when the model input is a MultiArray (ImageType models normalise internally)
FR_SCRFD_MEAN=127.5
FR_SCRFD_STD=128.0
FR_SCRFD_SIGMOID=false
FR_ARCFACE_MEAN=127.5
FR_ARCFACE_STD=127.5
FR_YOLO_MODEL=models/yolov7.mlpackage

# ---------------------------------------------------------------- detection
FR_DET_THRESHOLD=0.5
FR_NMS_THRESHOLD=0.4
FR_MIN_FACE_SIZE=40
FR_MAX_FACES=20
FR_DET_BATCH=4
FR_DET_MAX_WAIT_MS=8
FR_MAX_FRAME_AGE_S=1.0

# ---------------------------------------------------------------- person detection (YOLOv7)
# Used by cameras with `tasks: [person]` in config/cameras.yaml
FR_PERSON_CONF=0.4
FR_PERSON_NMS=0.45
FR_PERSON_CLASS_ID=0
FR_PERSON_NUM_CLASSES=80
# Only used when the model input is a MultiArray: pixel / std (YOLO expects 0..1)
FR_PERSON_INPUT_STD=255
FR_PERSON_MIN_HEIGHT=30
FR_PERSON_BATCH=4
FR_PERSON_MAX_WAIT_MS=8
# Cap person-detection fps per camera (0 = use the camera's fps)
FR_PERSON_MAX_FPS=0
# Tracker used to count distinct people (not the same person every frame)
FR_PERSON_TRACK_IOU=0.3
FR_PERSON_TRACK_MAX_AGE_S=2.0
FR_PERSON_TRACK_MIN_HITS=2
# One row per camera is appended to the person_counts table every N seconds
FR_PERSON_FLUSH_S=60
# IN/OUT counting for cameras with a count_zone (config/cameras.yaml):
# which point of the person box must cross the zone edge (bottom = feet, center = box centre)
FR_PERSON_ZONE_ANCHOR=bottom
# frames a person must stay on the new side before it counts (stops jitter on the edge)
FR_PERSON_ZONE_MIN_FRAMES=2
# Starting totals: called once before counting starts; facereco continues from the totals it returns
# (one row per device: a camera/device id + total and/or in / out columns). Empty = start at 0.
FR_PERSON_INIT_SQL=SELECT * FROM public.fn_initialize_device_personcount()
# Step 2: whenever a camera's IN / OUT totals change (checked every ~2 s) facereco calls this with
# (device id, total in, total out, 'YYYY-MM-DD HH:MM:SS'). Empty = off.
FR_PERSON_UPDATE_SQL=CALL sp_upsert_person_count_update(?, ?, ?, ?)
# IN / OUT totals written straight into this table: one 'In' and one 'Out' row per device per
# business_date (person_count = ml_givencount = day total, detected_personcount = added by this update),
# updated in place. Starting totals come from today's rows. Set to off to use the two SPs above instead.
# gate_id comes from the camera's gate_id column (camera SP / cameras.yaml), else the device's last row.
FR_PERSON_COUNT_TABLE=tbl_person_counts

# ---------------------------------------------------------------- recognition
FR_MATCH_THRESHOLD=0.45
FR_MATCH_MARGIN=0.05
FR_REC_BATCH=16
FR_REC_MAX_WAIT_MS=10
FR_REC_QUEUE=256
FR_BLUR_THRESHOLD=40
FR_MAX_YAW=0.45
FR_MIN_QUALITY=0.25
FR_EVENT_COOLDOWN_S=10
FR_RECORD_UNKNOWN=true
FR_UNKNOWN_COOLDOWN_S=30
FR_UNKNOWN_SIMILARITY=0.5
# Skip ArcFace for faces overlapping a recently identified face (big ANE saving)
FR_TRACK_IOU=0.45
FR_TRACK_REVERIFY_S=2.0
FR_GALLERY_RELOAD_S=30

# ---------------------------------------------------------------- ingestion
# auto | gstreamer | opencv
FR_INGESTION_BACKEND=auto
FR_RECONNECT_DELAY_S=2
FR_RECONNECT_MAX_DELAY_S=60
FR_STALE_TIMEOUT_S=15
FR_QUEUE_DEPTH=1
FR_CAMERAS_FILE=config/cameras.yaml

# ---------------------------------------------------------------- storage
# Database. Leave FR_DATABASE_URL and FR_PG_HOST empty to use the local SQLite file (FR_DB_PATH).
# PostgreSQL: either one URL ...
#   FR_DATABASE_URL=postgresql://facereco:secret@192.168.1.50:5432/facereco?sslmode=prefer
#   (URL-encode special characters in the password: @ -> %40, : -> %3A, / -> %2F, # -> %23)
# ... or separate fields (no encoding needed). Fields set here override the same part of the URL.
FR_DATABASE_URL=
FR_PG_HOST=
FR_PG_PORT=5432
FR_PG_USER=
FR_PG_PASSWORD=
FR_PG_DATABASE=
# disable | prefer | require | verify-ca | verify-full
FR_PG_SSLMODE=
FR_PG_POOL_MIN=1
FR_PG_POOL_MAX=10
FR_PG_CONNECT_TIMEOUT_S=15
FR_DB_PATH=data/face_recognition.db
FR_SAVE_SNAPSHOTS=false
FR_SNAPSHOT_QUALITY=85
FR_EVENT_FLUSH_S=1.0
FR_EVENT_BATCH=100
FR_EVENT_QUEUE=5000
FR_RETENTION_DAYS=90

# ---------------------------------------------------------------- monitoring
FR_HEALTH_HOST=127.0.0.1
FR_HEALTH_PORT=8085
FR_HEALTH_INTERVAL_S=30
FR_POWERMETRICS=true
FR_LOG_LEVEL=INFO
FR_LOGGING_CONFIG=config/logging.yaml

# ---------------------------------------------------------------- camera list source
# yaml = config/cameras.yaml.  db = call your stored procedure: each row returned is one camera and
# says which use case runs on it (tasks = face / person / face,person, or boolean face + person columns).
# Changes are applied automatically: instantly via NOTIFY (PostgreSQL), else on the next re-check.
FR_CAMERA_SOURCE=yaml
FR_CAMERA_SQL=SELECT * FROM public.fn_get_device_configuration()
FR_CAMERA_POLL_S=30
FR_CAMERA_NOTIFY_CHANNEL=camera_changed

# ---------------------------------------------------------------- HTTP API for the frontend
# python main.py api  (or run --api). Needs PostgreSQL and FR_CAMERA_SOURCE=db. Docs: http://HOST:PORT/docs
# The API and a backend calling the SPs directly write the same camera_config table: use either or both.
# FR_API_HOST=0.0.0.0 accepts requests from other machines - then set FR_API_KEY too
# (clients send the header X-API-Key: <key>). FR_API_CORS_ORIGINS: browser origins allowed to call it.
FR_API_HOST=127.0.0.1
FR_API_PORT=8090
FR_API_KEY=
FR_API_CORS_ORIGINS=
FR_API_TIMEZONE=Asia/Kolkata
# create camera_config + the SPs automatically when they're missing (python main.py db-setup does it by hand)
FR_API_AUTO_SETUP=true
